# ------------------------------------------------------------------------------
# Active Environment Variables
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
API_PORT=4000
WEB_ORIGIN=http://localhost:3000

# PostgreSQL Connection String
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/omnichain_tracker?schema=public

# Session Configuration
SESSION_SECRET=dev-insecure-session-secret-change-in-prod
SESSION_COOKIE_NAME=omnichain_session
SESSION_TTL_DAYS=30

# Redis Cache Configuration
REDIS_URL=redis://localhost:6379
TRANSACTION_CACHE_TTL_SECONDS=3600
TRANSACTION_CACHE_TTL_DEGRADED=60
TRANSACTION_CACHE_TTL_PENDING=0

# Blockchair Provider Configuration
BLOCKCHAIR_BASE_URL=https://api.blockchair.com
BLOCKCHAIR_API_KEY=
BLOCKCHAIR_TIMEOUT_MS=5000

# EVM RPC Endpoints for Transaction Story Enrichment
# Note: Configure dedicated or private provider endpoints for production resilience.
ETHEREUM_RPC_URL=https://ethereum-rpc.publicnode.com
BSC_RPC_URL=https://binance.llamarpc.com
POLYGON_RPC_URL=https://polygon-rpc.com

# Public Rate Limiting
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=30
