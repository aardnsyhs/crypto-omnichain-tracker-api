# ------------------------------------------------------------------------------
# Active Environment Variables (Milestones 1A, 2, 3)
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
API_PORT=4000
WEB_ORIGIN=http://localhost:3000

# PostgreSQL Connection String (Milestone 2)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/omnichain_tracker?schema=public

# Session Configuration (Milestone 2)
SESSION_SECRET=dev-insecure-session-secret-change-in-prod
SESSION_COOKIE_NAME=omnichain_session
SESSION_TTL_DAYS=30

# Redis Cache Configuration (Milestone 3)
REDIS_URL=redis://localhost:6379
TRANSACTION_CACHE_TTL_SECONDS=3600

# Blockchair Provider Configuration (Milestone 3)
BLOCKCHAIR_BASE_URL=https://api.blockchair.com
BLOCKCHAIR_API_KEY=
BLOCKCHAIR_TIMEOUT_MS=5000

# Public Rate Limiting (Milestone 3)
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=30

# ------------------------------------------------------------------------------
# Reserved for Future Milestones (Milestone 4+)
# ------------------------------------------------------------------------------
# STATS_ADMIN_TOKEN=
