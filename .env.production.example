NODE_ENV=production
API_HOST=127.0.0.1
PORT=4000
TRUST_LOCAL_PROXY=true
WEB_ORIGIN=https://tracker.ardiansyah.app
DATABASE_URL=postgresql://REPLACE_DB_USER:REPLACE_URL_ENCODED_PASSWORD@127.0.0.1:5432/REPLACE_DB_NAME?schema=public
REDIS_URL=redis://:REPLACE_URL_ENCODED_REDIS_PASSWORD@127.0.0.1:6379/0
SESSION_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32
SESSION_COOKIE_NAME=omnichain_session
SESSION_TTL_DAYS=30
HEALTH_TIMEOUT_MS=2000
TRANSACTION_CACHE_TTL_SECONDS=3600
TRANSACTION_CACHE_TTL_DEGRADED=60
TRANSACTION_CACHE_TTL_PENDING=0
BLOCKCHAIR_BASE_URL=https://api.blockchair.com
BLOCKCHAIR_API_KEY=REPLACE_BLOCKCHAIR_API_KEY
BLOCKCHAIR_TIMEOUT_MS=5000
ETHEREUM_RPC_URL=https://REPLACE_ETHEREUM_RPC_HOST/REPLACE_KEY
BSC_RPC_URL=https://REPLACE_LEGACY_BSC_RPC_HOST/REPLACE_KEY
POLYGON_RPC_URL=https://REPLACE_LEGACY_POLYGON_RPC_HOST/REPLACE_KEY
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=30
OVERVIEW_THROTTLE_LIMIT=60
REFRESH_COOLDOWN_SECONDS=15
