datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model UserSession {
  id              String          @id @default(uuid()) @db.Uuid
  sessionId       String          @unique @map("session_id")
  createdAt       DateTime        @default(now()) @map("created_at")
  lastActiveAt    DateTime        @default(now()) @map("last_active_at")
  expiresAt       DateTime        @map("expires_at")
  searchHistories SearchHistory[]

  @@map("user_sessions")
}

model SearchHistory {
  id              String      @id @default(uuid()) @db.Uuid
  userSessionId   String      @map("user_session_id") @db.Uuid
  userSession     UserSession @relation(fields: [userSessionId], references: [id], onDelete: Cascade)
  transactionHash String      @map("transaction_hash")
  chain           String
  outcome         String
  cacheHit        Boolean     @map("cache_hit")
  searchedAt      DateTime    @default(now()) @map("searched_at")

  @@index([userSessionId, searchedAt(sort: Desc)])
  @@map("search_histories")
}

model ApiRequestLog {
  id                 String   @id @default(uuid()) @db.Uuid
  requestId          String   @unique @map("request_id")
  provider           String   @default("blockchair")
  endpoint           String
  chain              String
  cacheOutcome       String   @map("cache_outcome")
  upstreamStatusCode Int?     @map("upstream_status_code")
  totalDurationMs    Int      @map("total_duration_ms")
  providerDurationMs Int?     @map("provider_duration_ms")
  outcome            String
  createdAt          DateTime @default(now()) @map("created_at")

  @@map("api_request_logs")
}
